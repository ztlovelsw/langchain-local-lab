# offline: no key, deterministic local demo (the default)
# openai: call an OpenAI-compatible chat endpoint
MODEL_PROVIDER=offline

# Only needed when MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional LangSmith tracing. Leave disabled while learning locally.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=langchain-local-lab
